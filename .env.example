GEMINI_API_KEY=your-gemini-key
IMAGE_PROVIDER=higgsfield        # higgsfield | pollinations | together | gemini | mock
TOGETHER_API_KEY=                # api.together.xyz — free FLUX.1-schnell-Free tier, no card
# TOGETHER_IMAGE_MODEL=          # default black-forest-labs/FLUX.1-schnell-Free
# GEMINI_TEXT_MODEL=             # default gemini-3.5-flash — override if the id is retired
# GEMINI_IMAGE_MODEL=            # default gemini-3.1-flash-image — needs a BILLED Google project
                                 #   (free tier returns 429, quota limit: 0, on every image model)
HF_API_KEY=                      # platform.higgsfield.ai — required when IMAGE_PROVIDER=higgsfield
HF_SECRET=
# HF_MODEL_PATH=                 # default higgsfield-ai/soul/standard (POST {base}/{path})
# HF_ASPECT_RATIO=               # default 1:1
# HF_RESOLUTION=                 # default 720p
OPENAI_API_KEY=                  # ChatGPT writes each painting's prompt from the diary entry;
                                 #   missing key → deterministic local prompt builder takes over
# OPENAI_MODEL=                  # default gpt-4o-mini — override if the id is retired
# COMMUNITY_REFRESH_MIN=         # default 15 — staleness window before the communal canvas repaints
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SESSION_SALT=any-long-random-string
DAILY_PAINTING_CAP=150
# MOCK_AI=1                      # test/e2e only — deterministic arcs, no Gemini calls
